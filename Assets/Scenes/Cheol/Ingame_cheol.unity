  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Control\nEmote : 1...4\t\tIngame Menu : Ingame Menu\n\nRound Progression\nNumber
    Distribution (1~10) -> Talk and Choice -> Result Reveal -> Press the Button\n\nNumber
    Distribution: Each player randomly receives a number between 1 and 10. You cannot
    see your own number; you can only see your opponent's number.\nTalk and Choice:
    While talking with your opponent, you must choose one of three options (GO, FOLD,
    OVERLOAD).\nResult Reveal: Both players' final choices and numbers are revealed.\nPress
    the Button: The player with the lower number presses their ejection button.\n\nChoice
    Types\nGO: Proceed without any special action.\nFOLD: Skip the result reveal
    and button press for this round, and move directly to the next round. The probability
    does not change.\nOVERLOAD: Temporarily increases the ejection probability for
    this round (1.5x if one player chooses it, 2x if both choose it).\n\nEjection
    Probability\nThe game starts with a 10% ejection probability. Every time the
    player with the lower number presses the button, the ejection probability increases
    after checking whether an ejection occurs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e327ac6b8dc44754f9cd0c18c07e2972, type: 2}
